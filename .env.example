# ── The agent's brain — pick ONE ─────────────────────────────
# Cerebras (free tier, Llama/Qwen) takes priority if both are set.

# Cerebras — free tier: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Optional: override the model (must support tool calling). Check
# https://inference-docs.cerebras.ai for the current list.
CEREBRAS_MODEL=llama-3.3-70b

# Anthropic (claude-opus-4-8) — leave blank if you're using Cerebras
ANTHROPIC_API_KEY=

# ── Optional integrations ────────────────────────────────────
# Leave any of these blank and that connector runs in DRY-RUN mode:
# it prints exactly what it *would* do and returns a fake ID, so the
# whole agent is demoable before you wire up a single external account.

# Notion — where meeting notes get filed.
# NOTION_API_KEY: an internal integration secret (starts with "ntn_" or "secret_")
# NOTION_DATABASE_ID: the database the agent adds a page to
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Linear — where action items become real tasks.
# LINEAR_API_KEY: a personal API key (starts with "lin_api_")
# LINEAR_TEAM_ID: the team UUID new issues are created under
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Gmail draft is dry-run by default (OAuth setup is a later episode).

# ══ Hundred — the agent store + MCP server ════════════════════
# Public base URL of your deployment (used in emails, MCP links, Stripe redirects)
PUBLIC_URL=http://localhost:8000
BRAND_NAME=Hundred
DATABASE_PATH=hundred.db

# Stripe — https://dashboard.stripe.com/apikeys  (use sk_test_ until launch)
STRIPE_SECRET_KEY=
# From the webhook endpoint you create for  <PUBLIC_URL>/stripe/webhook
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=7

# Transactional email via Resend (blank = dry-run: emails are logged, not sent)
RESEND_API_KEY=
EMAIL_FROM=Hundred <agents@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com

# Fair use: tool calls per key per UTC day (stops key sharing)
DAILY_CALL_LIMIT=3000
# Keys owning more tools than this get router mode (3 meta-tools) automatically
DIRECT_TOOL_LIMIT=40
# Signs the one-click post-purchase upgrade links (any long random string).
# If blank, a value derived from STRIPE_SECRET_KEY is used.
APP_SECRET=
