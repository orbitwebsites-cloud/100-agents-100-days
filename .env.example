# ── The agent's brain — pick ONE ─────────────────────────────
# Cerebras (free tier, Llama/Qwen) takes priority if both are set.

# Cerebras — free tier: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Optional: override the model (must support tool calling). Check
# https://inference-docs.cerebras.ai for the current list.
CEREBRAS_MODEL=llama-3.3-70b

# Anthropic (claude-opus-4-8) — leave blank if you're using Cerebras
ANTHROPIC_API_KEY=

# ── Optional integrations ────────────────────────────────────
# Leave any of these blank and that connector runs in DRY-RUN mode:
# it prints exactly what it *would* do and returns a fake ID, so the
# whole agent is demoable before you wire up a single external account.

# Notion — where meeting notes get filed.
# NOTION_API_KEY: an internal integration secret (starts with "ntn_" or "secret_")
# NOTION_DATABASE_ID: the database the agent adds a page to
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Linear — where action items become real tasks.
# LINEAR_API_KEY: a personal API key (starts with "lin_api_")
# LINEAR_TEAM_ID: the team UUID new issues are created under
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Gmail draft (Meeting Ops) is dry-run by default (OAuth setup is a later episode).

# Inbox Assistant — reads Gmail, answers questions, archives clutter.
# Leave blank to read/archive against the bundled sample inbox instead.
# Real Gmail: download an OAuth Desktop client JSON from Google Cloud Console,
# save it to credentials/gmail_credentials.json (or point
# GMAIL_CREDENTIALS_FILE at it), then run `python run_inbox.py --gmail-auth`
# once. After that the token file's presence is what flips dry-run off.
# GMAIL_CREDENTIALS_FILE=./credentials/gmail_credentials.json
# GMAIL_TOKEN_FILE=./credentials/gmail_token.json
GMAIL_TOKEN=

# Inbox Assistant over Telegram — the real trigger. Message the bot, get an
# answer; it can also push proactive alerts on its own (see --watch).
# TELEGRAM_BOT_TOKEN: create a bot with @BotFather, paste the token it gives you.
# TELEGRAM_CHAT_ID: your own chat id from @userinfobot — restricts the bot to you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How many days ahead the proactive digest (--digest / --watch) flags an
# expiring document, and how often --watch re-checks the inbox.
# DIGEST_LOOKAHEAD_DAYS=3
# WATCH_INTERVAL_MINUTES=30

# Optional: override where the local SQLite email store lives.
# INBOX_DB_PATH=./inbox.db
